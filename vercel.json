{
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "migrations/**"
    },
    "api/staging-ops.ts": {
      "includeFiles": "migrations/**"
    },
    "api/cron/publication-lifecycle.ts": {
      "includeFiles": "migrations/**"
    }
  },
  "rewrites": [
    { "source": "/p/:slug", "destination": "/p/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/publication-lifecycle", "schedule": "0 3 * * *" }
  ]
}
