# Vercel local development only. Never use this local file database remotely.
DATABASE_PROVIDER=turso
TURSO_DATABASE_URL=file:.local/crushify-vercel.db
TURSO_AUTH_TOKEN=

# Local mock storage, email inbox, and payment only; no external provider calls.
STORAGE_PROVIDER=mock
LOCAL_TEST_MODE=true
LOCAL_TEST_MAIL_SINK_URL=http://127.0.0.1:8025/__crushify_test_email_sink
PAYMENT_MODE=mock
ADMIN_EMAILS=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
# Optional local manual-transfer mode; use only synthetic details in local tests.
MANUAL_BANK_CODE=
MANUAL_BANK_ACCOUNT=
MANUAL_ACCOUNT_NAME=
APP_ORIGIN=http://localhost:3000

# Vercel Preview only. Choose exactly one mode when Preview sign-in is enabled:
# PREVIEW_EMAIL_SINK=discard
# or the separately scoped Preview Resend configuration:
# PREVIEW_MAIL_PROVIDER=resend
# PREVIEW_MAIL_API_KEY=
# PREVIEW_MAIL_FROM_EMAIL=
# PREVIEW_AUTH_ALLOWED_EMAILS=qa@example.test
# Choose exactly one Preview payment mode:
# PREVIEW_PAYMENT_MODE=sepay-test with PREVIEW_SEPAY_* settings, or
# PREVIEW_PAYMENT_MODE=manual-bank-transfer with PREVIEW_MANUAL_BANK_CODE,
# PREVIEW_MANUAL_BANK_ACCOUNT, and PREVIEW_MANUAL_ACCOUNT_NAME.
# Preview administrators must also appear in ADMIN_EMAILS. Never reuse
# Production MAIL_* credentials in Preview.
