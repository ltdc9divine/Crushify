    # Vercel local development only. The migration script creates .local/ when
    # needed. Use a separate remote test database for Vercel Preview deployments.
    DATABASE_PROVIDER=turso
    TURSO_DATABASE_URL=file:.local/crushify-vercel.db
    TURSO_AUTH_TOKEN=

    # `mock` is accepted only in local Vercel development with LOCAL_TEST_MODE=true.
    STORAGE_PROVIDER=mock
    LOCAL_TEST_MODE=true
    APP_ORIGIN=http://localhost:3000

    # Cloudinary is not configured in local development. The current runtime
    # permits it only in Production; Preview and local runtimes remain disabled.

    # SePay local-only test configuration; no Live mode is supported.
    PAYMENT_MODE=
    SEPAY_WEBHOOK_SECRET=
    SEPAY_BANK_CODE=
    SEPAY_BANK_ACCOUNT=
    SEPAY_ACCOUNT_NAME=

    # Email provider (optional)
    MAIL_PROVIDER=
    MAIL_API_KEY=
    MAIL_FROM_EMAIL=
